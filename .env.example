# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/giftaura
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/giftaura?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=giftaura-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Business WhatsApp Configuration
# WhatsApp Business number with international country code (no + or spaces)
NEXT_PUBLIC_WHATSAPP_PHONE=918087142499
WHATSAPP_PHONE=918087142499

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Storage / Upload Configuration
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_MB=5
